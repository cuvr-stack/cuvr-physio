# ── Supabase (shared across api/dashboard/vr-app) ────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key — API only, never exposed to clients
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Standalone aliases used by the API process
SUPABASE_URL=your_supabase_url

# ── API + Socket.io ──────────────────────────────────────────────
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
PORT=3001

# Allowed CORS origins (defaults work for local dev)
VR_APP_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002

# ── AI features (Coach / Insights / SOAP) ────────────────────────
# Without this, the system falls back to deterministic rule engines
ANTHROPIC_API_KEY=sk-ant-...
AI_COACH_MODEL=claude-haiku-4-5
AI_COACH_TICK_MS=5000

# ── Idle auto-logout (dashboard) ─────────────────────────────────
# Defaults: 15 min idle, 30 s warning. Lower these for testing.
NEXT_PUBLIC_IDLE_TIMEOUT_MS=900000
NEXT_PUBLIC_IDLE_WARNING_MS=30000

# ── Optional: Redis (Upstash) for production rate limiting ──────
REDIS_URL=
REDIS_TOKEN=

# ── Optional: Socket.io ─────────────────────────────────────────
SOCKET_SECRET=
